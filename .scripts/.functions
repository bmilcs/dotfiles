# 
# bmilcs functions
#

ask_yes_no() {
    local prompt="$1"
    local default="$2"
    local reply

    while true; do
        # Format prompt to show default choice in uppercase
        if [[ "$default" == "Y" ]]; then
            read -p "$prompt [Y/n]: " reply
        elif [[ "$default" == "N" ]]; then
            read -p "$prompt [y/N]: " reply
        else
            read -p "$prompt [y/n]: " reply
        fi

        # If user hits Enter without typing, use the default choice
        if [[ -z "$reply" && -n "$default" ]]; then
            reply="$default"
        fi

        # Convert reply to lowercase and check value
        case "${reply,,}" in
            y|yes) return 0 ;;
            n|no)  return 1 ;;
            *)     echo "Invalid input. Please enter check 'y' or 'n'." ;;
        esac
    done
}
